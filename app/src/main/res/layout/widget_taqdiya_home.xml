<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="كناش التقدية"
            android:textColor="#F4EFE6"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pocket_badge_bg"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="تحديث"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Pocket Balance Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_pocket_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الباقي في الجيب: "
            android:textColor="#D7CFC2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_pocket_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="200 درهم (4000 ريال)"
            android:textColor="#F08A5D"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Missing Items Summary -->
    <TextView
        android:id="@+id/widget_items_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="النواقص: اضغط لفتح الكناش وتسجيل التقدية"
        android:textColor="#F4EFE6"
        android:textSize="13sp" />

</LinearLayout>
